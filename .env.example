NEXT_PUBLIC_MUX_SHOWREEL_PLAYBACK_ID=
NEXT_PUBLIC_MUX_HOUSE_SHOWREEL_PLAYBACK_ID=
NEXT_PUBLIC_MUX_FESTIVAL_SHOWREEL_PLAYBACK_ID=

# Safe for browser exposure. Used by the Next.js frontend to read published Sanity content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-side only. Keep empty for public published reads; reserve for future preview/private reads.
SANITY_API_READ_TOKEN=

# Server-side only. Required for the trusted YouTube importer to create/update Sanity documents.
SANITY_API_WRITE_TOKEN=

# Server-side only. Required for YouTube Data API reads.
YOUTUBE_API_KEY=

# Server-side only. Comma-separated official Animae Caribe YouTube channel IDs.
# Official all-upload import is disabled unless a source channel ID is in this allowlist.
OFFICIAL_ANIMAE_CARIBE_YOUTUBE_CHANNEL_IDS=

# Server-side only. Required to trigger /api/youtube-import from cron or external callers.
CRON_SECRET=

# Optional importer limits.
YOUTUBE_BACKFILL_MAX_PAGES=10
YOUTUBE_BACKFILL_MAX_RESULTS=250
YOUTUBE_RECENT_SYNC_MAX_RESULTS=25
YOUTUBE_HISTORICAL_FROM_YEAR=2005
YOUTUBE_HISTORICAL_TO_YEAR=
YOUTUBE_HISTORICAL_WINDOW=year
YOUTUBE_HISTORICAL_MAX_RESULTS_PER_KEYWORD_YEAR=50

